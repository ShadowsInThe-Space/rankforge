generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Audit {
  id         String   @id @default(cuid())
  url        String
  domain     String
  status     String   @default("pending") // pending, mapping, crawling, analyzing, done, error
  score      Int?     // 0-100
  grade      String?  // A, B, C, D, F
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // User relation for multi-tenancy
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Firecrawl Job Tracking
  crawlJobId String?
  pagesFound Int      @default(0)
  keywords   String[] // Target-Keywords für Content Benchmark

  // Analyse-Ergebnisse als JSON
  technical Json? // Technical SEO findings
  content   Json? // Content Intelligence findings
  links     Json? // Link Graph data
  summary   Json? // Executive Summary + Score Breakdown
  
  // Enterprise Analysis (Google Leak 2024)
  dateConsistency  Json? // Date Consistency Analysis (Module F)
  indexTier        Json? // Index Tier Prediction (Module B)
  navboostScore    Int?  // NavBoost overall score (Module A)
  navboostAnalysis Json? // NavBoost detailed analysis (Module A)
  linkTierScore    Int?  // Link Tier overall score (Module E)
  linkTierAnalysis Json? // Link Tier detailed analysis (Module E)
  
  // Advanced SEO Analysis (SEOptimer-style checks)
  advancedSeo Json? // Advanced SEO findings (title keyword, meta, performance, mobile, schema, social)

  // Core Web Vitals (Google PageSpeed Insights)
  coreWebVitals Json? // Core Web Vitals metrics (LCP, FID, CLS)

  // Error tracking
  error String?

  // Sharing
  isPublic    Boolean  @default(false)
  shareToken  String?  @unique // UUID for unguessable share links

  pages Page[]

  @@index([domain])
  @@index([status])
}

model Page {
  id          String  @id @default(cuid())
  auditId     String
  userId      String? // Denormalized for easier queries
  url         String
  statusCode  Int?
  title       String?
  description String?
  h1          String?
  wordCount   Int?
  markdown    String? @db.Text
  html        String? @db.Text
  links       Json? // { internal: [], external: [] }
  headings    Json? // H1-H6 structure
  issues      Json? // Array of issues found
  score       Int? // Page-level score
  contentType String? // blog, product, landing, etc.

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([url])
  @@index([userId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String   // Hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits         Audit[]
  auditHistories AuditHistory[]
}

// ─── Audit History: Snapshots of completed audits ────────────

model AuditHistory {
  id            String   @id @default(cuid())
  auditId       String   // Reference to original audit
  domain        String
  
  // Score & Grade at time of snapshot
  score         Int
  grade         String
  
  // Snapshot of key data (JSON) for comparison
  technical     Json?
  content       Json?
  links         Json?
  summary       Json?
  advancedSeo   Json?
  
  // Enterprise modules snapshot
  dateConsistency Json?
  indexTier     Json?
  navboostScore Int?
  navboostAnalysis Json?
  linkTierScore Int?
  linkTierAnalysis Json?
  
  // Meta
  createdAt     DateTime @default(now())
  pagesFound    Int      @default(0)
  
  // User relation
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([domain])
  @@index([userId])
  @@index([createdAt])
}
