# RankForge — Environment
# Kopieren nach .env und ausfüllen.

# --- Pflicht ---

# PostgreSQL-Verbindung (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/rankforge"

# Auth
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="change-me-to-a-long-random-string"

# Shared Secret für interne API-Aufrufe (z. B. aus Mission Control)
INTERNAL_API_KEY="change-me-too"

# --- Optional ---

# Firecrawl-Instanz für Crawling (ohne diesen Key kein Live-Crawl)
# FIRECRAWL_API_URL="http://localhost:3002"

# Google PageSpeed API (Performance-Signale)
# GOOGLE_PAGESPEED_API_KEY=""

# Stripe-Billing (Pro/Enterprise-Upgrade-Flow)
# STRIPE_SECRET_KEY=""
# STRIPE_PRO_PRICE_ID=""
# STRIPE_ENTERPRISE_PRICE_ID=""
